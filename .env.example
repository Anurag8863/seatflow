# ---------------------------------------------------------------------------
# SeatFlow — environment configuration
# Copy to .env (root) or backend/.env and fill in real values.
# NEVER commit the populated .env file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Railway injects this automatically when you
# attach a Postgres plugin (use ${{Postgres.DATABASE_URL}} in the Railway UI).
DATABASE_URL="postgresql://seatflow:seatflow@localhost:55432/seatflow?schema=public"

# Separate database used by the automated test-suite. Tests TRUNCATE tables,
# so this must NOT point at a database holding real data.
TEST_DATABASE_URL="postgresql://seatflow:seatflow@localhost:55432/seatflow_test?schema=public"

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
# Leave empty in production when the API also serves the built frontend
# (same-origin, no CORS needed).
CORS_ORIGIN="http://localhost:5173"

# --- Authentication -------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime for the issued JWT.
JWT_EXPIRES_IN="12h"

# --- Seed admin account ---------------------------------------------------
# Used only by `npm run db:seed`. Change these before any real deployment.
SEED_ADMIN_EMAIL="admin@seatflow.io"
SEED_ADMIN_PASSWORD="SeatFlow!2024"
SEED_ADMIN_NAME="Avery Collins"

# --- AI provider ----------------------------------------------------------
# AI_PROVIDER: gemini | groq | local
#   gemini -> Google Gemini API      (https://aistudio.google.com/apikey)
#   groq   -> Groq Cloud API         (https://console.groq.com/keys)
#   local  -> built-in deterministic interpreter, no API key required
# The key is read on the server only and is never sent to the browser.
AI_PROVIDER="local"
AI_API_KEY=""
# Optional model override (defaults: gemini-2.0-flash / llama-3.3-70b-versatile)
AI_MODEL=""
# Requests per minute per admin against /api/ai/*
AI_RATE_LIMIT_PER_MINUTE=20
